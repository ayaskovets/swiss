{
    "version": 6,
    "configurePresets": [
        {
            "name": "clang-debug",
            "displayName": "clang-debug",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}/install",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_INIT": "-g -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion -Wcast-align -Wcast-qual -Wnull-dereference -Woverloaded-virtual -Werror -fsanitize=address",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "clang-release",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}/install",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_INIT": "-O3",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "clang-debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "displayName": "clang-release"
        }
    ],
    "testPresets": [
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "clang-debug",
            "output": {
                "verbosity": "verbose"
            }
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "displayName": "clang-release",
            "output": {
                "verbosity": "verbose"
            }
        }
    ]
}
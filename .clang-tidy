Checks: "*,
        -llvm*,
        -fuchsia*,
        -google-readability-avoid-underscore-in-googletest-name,
        -readability-redundant-access-specifiers,
        -readability-named-parameter,
        -hicpp-named-parameter,
        -readability-magic-numbers,
        -hicpp-special-member-functions"
FormatStyle: none
WarningsAsErrors: "*"

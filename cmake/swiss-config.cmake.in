@PACKAGE_INIT@

include(CMakePackageConfigHelpers)

macro(import_targets)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/swiss-targets.cmake")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "swiss libraries were requested but not found")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND OFF)
        return()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/swiss-targets.cmake")
endmacro()

if(NOT TARGET swiss::swiss)
    import_targets()
    check_required_components(swiss)
    message("-- Found swiss (version ${${CMAKE_FIND_PACKAGE_NAME}_VERSION})")
endif()

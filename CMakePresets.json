{
    "version": 8,
    "configurePresets": [
        {
            "name": "debug",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_CXX_FLAGS": "-g -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion -Wcast-align -Wcast-qual -Wnull-dereference -Woverloaded-virtual -Werror -fsanitize=address",
                "SWISS_BUILD_TESTING": "ON",
                "SWISS_INSTALL": "OFF"
            }
        },
        {
            "name": "release",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}/install",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SWISS_BUILD_TESTING": "OFF",
                "SWISS_INSTALL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "install",
            "configurePreset": "release",
            "targets": [
                "install"
            ]
        },
        {
            "name": "unit-tests",
            "configurePreset": "debug"
        }
    ],
    "testPresets": [
        {
            "name": "unit-tests",
            "configurePreset": "debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "unit-tests",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "unit-tests"
                },
                {
                    "type": "test",
                    "name": "unit-tests"
                }
            ]
        },
        {
            "name": "install",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "install"
                }
            ]
        }
    ]
}